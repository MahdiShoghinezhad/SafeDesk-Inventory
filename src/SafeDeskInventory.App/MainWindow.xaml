<Window x:Class="SafeDeskInventory.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SafeDesk Inventory — Local Software Audit"
        Width="1180" Height="760" MinWidth="940" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#0B1323"
        FontFamily="Segoe UI">
  <Window.Resources>
    <SolidColorBrush x:Key="Panel" Color="#162238"/>
    <SolidColorBrush x:Key="Accent" Color="#61E4C5"/>
    <SolidColorBrush x:Key="Ink" Color="#EDF4FF"/>
    <SolidColorBrush x:Key="Muted" Color="#A5B6CC"/>
    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="Foreground" Value="#0B1323"/>
      <Setter Property="Background" Value="#61E4C5"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="18,10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Border" Property="Opacity" Value="0.5"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="Opacity" Value="0.82"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Foreground" Value="#EDF4FF"/>
      <Setter Property="Background" Value="#2B3B53"/>
    </Style>
    <Style x:Key="KpiText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#EDF4FF"/>
      <Setter Property="FontSize" Value="30"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="KpiLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#9AADC4"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>
  </Window.Resources>

  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="22"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="22"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="14"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Foreground="#61E4C5" FontSize="12" FontWeight="SemiBold" Text="ON-DEVICE • EXPLICIT CONSENT • READ ONLY"/>
        <TextBlock Margin="0,6,0,0" Text="SafeDesk Inventory" FontSize="32" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
        <TextBlock Margin="0,5,0,0" Text="A local inventory of public software installation metadata. Never reads wallet secrets." Foreground="{StaticResource Muted}" FontSize="13"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="DemoButton" Content="Load demo" Style="{StaticResource SecondaryButton}" Click="Demo_Click" Margin="0,0,10,0"/>
        <Button x:Name="ScanButton" Content="Scan this PC" Style="{StaticResource ActionButton}" Click="Scan_Click"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" CornerRadius="12" Background="{StaticResource Panel}" Padding="18">
        <StackPanel><TextBlock x:Name="TotalText" Text="0" Style="{StaticResource KpiText}"/><TextBlock Text="Inventory observations" Style="{StaticResource KpiLabel}"/></StackPanel>
      </Border>
      <Border Grid.Column="2" CornerRadius="12" Background="{StaticResource Panel}" Padding="18">
        <StackPanel><TextBlock x:Name="DesktopText" Text="0" Style="{StaticResource KpiText}"/><TextBlock Text="Desktop applications" Style="{StaticResource KpiLabel}"/></StackPanel>
      </Border>
      <Border Grid.Column="4" CornerRadius="12" Background="{StaticResource Panel}" Padding="18">
        <StackPanel><TextBlock x:Name="ExtensionText" Text="0" Style="{StaticResource KpiText}"/><TextBlock Text="Browser extensions" Style="{StaticResource KpiLabel}"/></StackPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="INVENTORY" Foreground="{StaticResource Ink}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
        <Border Margin="14,0,0,0" Padding="10,5" CornerRadius="12" Background="#29433D">
          <TextBlock x:Name="ModeText" Text="DEMO — SYNTHETIC DATA" FontWeight="SemiBold" FontSize="11" Foreground="#A1F4D7"/>
        </Border>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <TextBox x:Name="SearchBox" Width="220" Height="37" Margin="0,0,10,0"
                 Background="#162238" Foreground="#EDF4FF" BorderBrush="#34455F"
                 BorderThickness="1" Padding="10,8" VerticalContentAlignment="Center"
                 ToolTip="Filter results by name, browser or source" TextChanged="Search_Changed"/>
        <Button x:Name="ExportButton" Content="Export CSV" Style="{StaticResource SecondaryButton}" Click="Export_Click"/>
      </StackPanel>
    </Grid>

    <Border Grid.Row="6" Background="{StaticResource Panel}" CornerRadius="12" Padding="8">
      <DataGrid x:Name="InventoryGrid" AutoGenerateColumns="False" IsReadOnly="True"
                HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                Background="{StaticResource Panel}" Foreground="{StaticResource Ink}"
                BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#2A3A52"
                RowBackground="#162238" AlternatingRowBackground="#1B2B44"
                ColumnHeaderHeight="44" RowHeight="44" AlternationCount="2" SelectionMode="Single"
                FontSize="13" EnableRowVirtualization="True">
        <DataGrid.Resources>
          <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#223148"/><Setter Property="Foreground" Value="#DCE9FA"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="12,0"/>
          </Style>
          <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#EDF4FF"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
          </Style>
        </DataGrid.Resources>
        <DataGrid.Columns>
          <DataGridTextColumn Header="PRODUCT" Binding="{Binding Name}" Width="1.35*"/>
          <DataGridTextColumn Header="TYPE" Binding="{Binding Kind}" Width="1.4*"/>
          <DataGridTextColumn Header="SOURCE" Binding="{Binding Source}" Width="2.1*"/>
          <DataGridTextColumn Header="BROWSER" Binding="{Binding Browser}" Width="*"/>
          <DataGridTextColumn Header="PROFILE" Binding="{Binding Profile}" Width="*"/>
          <DataGridTextColumn Header="VERSION" Binding="{Binding Version}" Width="*"/>
          <DataGridTextColumn Header="INSTALL DATE" Binding="{Binding InstallDate}" Width="1.25*"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <Grid Grid.Row="7" Margin="0,15,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" Text="Demo records only. Click Scan this PC to scan locally." TextWrapping="Wrap"/>
      <TextBlock Grid.Column="1" Foreground="#61E4C5" Text="NO NETWORK • NO SECRETS • NO AUTO-SCAN" FontSize="11" FontWeight="SemiBold"/>
    </Grid>
  </Grid>
</Window>
